{
  "name": "zotero-citation-graph",
  "version": "0.66.0",
  "private": true,
  "description": "Force-directed citation graph for a Zotero collection",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jajaho/zotero-citation-graph.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tools/test-cjs-shim.js",
    "check-version": "node tools/check-version.js",
    "verify": "node tools/check-version.js && node tools/test-cjs-shim.js",
    "build": "node tools/build-xpi.js",
    "bench-ref": "node tools/bench/referencing/score.js",
    "bench-ref:external": "node tools/bench/referencing/build-external.js",
    "bench": "node tools/bench/rendering/run.js",
    "bench:report": "node tools/bench/rendering/run.js --md",
    "bench:sweep": "node tools/bench/rendering/run.js --matrix --md",
    "bench:open": "node tools/bench/rendering/open.js",
    "bench:serve": "node tools/bench/rendering/serve.js",
    "strategies": "node tools/cli.js --list",
    "install-dev": "powershell -ExecutionPolicy Bypass -File tools/install-dev.ps1"
  }
}
